# WonderHug.Life — environment template
# Copy values into web/.env.local and never commit secrets.
# Service-role and Razorpay secret stay on Supabase / CI only.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://wonderhug.life
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_AISENSY_WHATSAPP_URL=https://wa.me/
NEXT_PUBLIC_AISENSY_API_KEY=

# Mobile (--dart-define)
# SUPABASE_URL
# SUPABASE_ANON_KEY
# RAZORPAY_KEY_ID
# FCM: add google-services.json / GoogleService-Info.plist when Firebase is ready
